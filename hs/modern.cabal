cabal-version:      3.0
name:               modern
version:            0.1.0
synopsis:           modern project — typed projection: manifest in, §12 tree out
license:            MIT
build-type:         Simple

common warnings
    ghc-options: -Wall -Werror -Wcompat

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  Modern.Manifest
                      Modern.Project
                      Modern.Scrub
                      Modern.Gate
    build-depends:    base >=4 && <5,
                      aeson,
                      bytestring,
                      containers,
                      directory,
                      filepath,
                      process,
                      shelly,
                      text,
                      unix
    default-language: GHC2021

executable modern
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base, modern, aeson, bytestring, text
    default-language: GHC2021

test-suite modern-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:    base, modern, bytestring, directory, filepath, temporary
    default-language: GHC2021
